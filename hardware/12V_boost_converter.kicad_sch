	(text "10µF tantalum || 0.1uF X7R.\nESR < 10Ω required.\nAll caps placed at LDO output pin."
		(exclude_from_sim no)
		(at 212.725 103.505 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify right)
		)
		(uuid "0e2c93f8-8e86-43b9-9ad2-dc9f00e7cb52")
	)
	(text "Boost Converter"
		(exclude_from_sim no)
		(at 103.505 34.29 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
				(color 132 0 0 1)
			)
		)
		(uuid "0fd0cb83-9caa-4ad1-9dde-c9c1f1f78f02")
	)
	(text "Pulled LOW via a 47k resistor\nto set the default state to OFF.\n\nAn optional pull-up resistor\n(R6) allows manual control."
		(exclude_from_sim no)
		(at 76.835 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify right)
		)
		(uuid "16521721-741a-48ac-9c15-5b3edd3a2b77")
	)
	(text "R1 = R2 * (V_{pos}/V_{ref} - 1)\nR1 = 100k * (13.4/1.213 - 1) = 1.00M ≈ 1.0M (E3)"
		(exclude_from_sim no)
		(at 154.94 46.99 0)
		(effects
			(font
				(size 0.762 0.762)
				(thickness 0.1524)
				(bold yes)
			)
			(justify right)
		)
		(uuid "18e7e717-7c15-434b-b796-12a18df6af3d")
	)
	(text "Description"
		(exclude_from_sim no)
		(at 159.385 140.335 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "4aef065b-baf3-48f2-a28b-0d07e4922d85")
	)
	(text "R3 = -R4 * (V_{neg}/V_{ref})\nR3 = -100k * (-13.4/1.213)\n= 1.10M ≈ 1.1M (E24)"
		(exclude_from_sim no)
		(at 116.205 60.96 0)
		(effects
			(font
				(size 0.762 0.762)
				(thickness 0.1524)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left)
		)
		(uuid "5b0d8b79-b6a5-4132-9493-3a675a6913fa")
	)
	(text "ENP and ENN tied together\nand exposed via EN pin to\nallow MCU control over PSU."
		(exclude_from_sim no)
		(at 76.835 97.155 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.0953)
			)
			(justify right)
		)
		(uuid "5d2602e9-11b9-47df-bf66-e18cc66df761")
	)
	(text "Power-Save (Burst Mode) disabled\nto reduce output ripple magnitude\nand because efficiency is identical\nat ~100mA output current."
		(exclude_from_sim no)
		(at 90.805 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.0953)
			)
			(justify left)
		)
		(uuid "7c942d96-70e0-4949-a5ff-b2253ffd7475")
	)
	(text "22µF tantalum || 0.1uF X7R\nTantalum ESR satisfies (100mΩ-1Ω)\nDo not substitute ceramic alone."
		(exclude_from_sim no)
		(at 212.725 70.485 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify right)
		)
		(uuid "81932c98-857d-4caf-a390-3e1bb475916e")
	)
	(text "TPS65131 dual boost converter produces +13.4V/−13.4V, providing >1V headroom into the LDOs.\nSwitching frequency 1.38MHz; estimated boost output ripple 5-10mV.\n\n+12V rail (600mA max)\n  Dropout 0.5V typ / 1V max. Output noise 270-300µVrms (10Hz-100kHz).\n  70dB PSRR at 1.38MHz attenuates 10mV boost ripple to <10µV at LDO output.\n\n−12V rail (400mA max)\n  Dropout 0.6V typ / 1V max. Output noise 500-1500µVrms max (10Hz-100kHz).\n  20dB PSRR at 1.38MHz attenuates 10mV boost ripple to <1mV at LDO output.\n\n  Note: weaker PSRR on negative rail - consider RC filter at analog stage if needed."
		(exclude_from_sim no)
		(at 160.655 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "9de71bc2-eadd-4359-8c15-c9c4eb3ac173")
	)
