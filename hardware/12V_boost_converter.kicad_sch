	(text "Boost Converter"
		(exclude_from_sim no)
		(at 95.25 50.8 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
				(color 132 0 0 1)
			)
		)
		(uuid "0fd0cb83-9caa-4ad1-9dde-c9c1f1f78f02")
	)
	(text "Pulled LOW via a 47k resistor\nto set the default state to OFF.\n\nAn optional pull-up resistor\n(R6) allows manual control."
		(exclude_from_sim no)
		(at 68.58 118.745 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify right)
		)
		(uuid "16521721-741a-48ac-9c15-5b3edd3a2b77")
	)
	(text "R1 = R2 * (V_{pos}/V_{ref} - 1)\n100k * (13/1.213 - 1)\n= 972k ≈ 976k (E96)"
		(exclude_from_sim no)
		(at 146.05 57.785 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1524)
				(bold yes)
			)
			(justify right)
		)
		(uuid "18e7e717-7c15-434b-b796-12a18df6af3d")
	)
	(text "Description"
		(exclude_from_sim no)
		(at 12.7 14.605 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "4aef065b-baf3-48f2-a28b-0d07e4922d85")
	)
	(text "R3 = -R4 * (V_{neg}/V_{ref})\n= -100k * (-13/1.213)\n= 1.07M ≈ 1.07M (E96)"
		(exclude_from_sim no)
		(at 107.95 71.755 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1524)
				(bold yes)
				(color 0 0 194 1)
			)
			(justify left)
		)
		(uuid "5b0d8b79-b6a5-4132-9493-3a675a6913fa")
	)
	(text "22 µF output capacitors exceed\nthe 10 µF minimum recommendation,\nproviding additional charge\nreservoir for supply rail stability\nduring fast output transients."
		(exclude_from_sim no)
		(at 207.645 79.375 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1524)
				(bold yes)
			)
			(justify left)
		)
		(uuid "5b8b3198-ca9c-4491-940d-0e8bd3a350bc")
	)
	(text "ENP and ENN tied together\nand exposed via EN pin to\nallow MCU control over PSU."
		(exclude_from_sim no)
		(at 68.58 109.855 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.0953)
			)
			(justify right)
		)
		(uuid "5d2602e9-11b9-47df-bf66-e18cc66df761")
	)
	(text "VNEG = V_{NR/SS} * (-R_{1P}/R_{2P})\n1.19V * (-101k/10k) = -12.019V"
		(exclude_from_sim no)
		(at 196.215 100.965 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1524)
				(bold yes)
			)
			(justify left)
		)
		(uuid "788c4e87-ee70-4d29-9878-d981cc16f323")
	)
	(text "VPOS = V_{NR/SS} * (1 + R_{1P}/R_{2P})\n1.19V * (1 + 91k/10k) = 12.019V"
		(exclude_from_sim no)
		(at 196.215 59.055 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1524)
				(bold yes)
			)
			(justify left)
		)
		(uuid "7c260132-8c18-4d92-913a-9a4f4c802c5e")
	)
	(text "Power-Save (Burst Mode) disabled\nto reduce output ripple magnitude\nand because efficiency is identical\nat ~100mA output current."
		(exclude_from_sim no)
		(at 82.55 121.285 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.0953)
			)
			(justify left)
		)
		(uuid "7c942d96-70e0-4949-a5ff-b2253ffd7475")
	)
	(text "5V USB input boosted to ±13V at 1.38MHz,\nthen regulated to ±12V by a dual LDO.\n\nRipple from the boost is attenuated by\n50-60dB PSRR before reaching the amplifier\nsupply pins. Output voltage set by external\nresistor dividers."
		(exclude_from_sim no)
		(at 13.335 24.765 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "9de71bc2-eadd-4359-8c15-c9c4eb3ac173")
	)
